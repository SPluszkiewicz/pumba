# Secrets / local config
.env
atlassian.env

# Model weights. models/README.md is the only tracked file here.
# Shards live in a subdirectory (models/UD-Q5_K_M/), which models/*.gguf misses.
models/*
!models/README.md

# Build outputs
build/
out/
*.o
*.obj

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
.venv-wsl/
.venv-win/
*.egg-info/

# Docs build output
site/

# Editor / OS
.vscode/
.cursor/
.idea/
Thumbs.db
.DS_Store
~$*

# Local tickets, benches, and scratch checkouts (docs/agents/ is the convention)
.scratch/

# Serena project state written when a checkout is activated on the host
.serena/

# Qdrant local data (if ever run outside a named volume)
qdrant_storage/

# Portable source zip (`python scripts/deploy.py export`)
*.zip

# Transient stdin prompt for `deploy.py ask -`
.prompt.tmp

# Runtime state: workspaces, locks, pids, logs, the expose allow-list,
# the profile-campaign report, and the downloaded llama-server binary.
state/
.wsl-setup/
wsl-distro/
