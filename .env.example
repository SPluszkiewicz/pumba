# Copy to .env and fill in real values before `python scripts/deploy.py up`.
# Every service reads its config exclusively from these names - see CONTRACTS.md.
#
# You set three values: CONTAINER_RUNTIME, CODEBASE_PATH, AGENT_BEARER_TOKEN.
# `python scripts/deploy.py gpu-profile <name>` rewrites the GPU block.
# `python scripts/deploy.py up` is the only start command. On the evo-x5
# profile it also starts llama-server on the host and skips the llm container.
# Ports, *_BASE_URL, and *_PROJECT_ROOT are the wiring between containers.
# Leave them unless a profile just wrote them.

# Engine for scripts/deploy.py: auto (Podman, else Docker), podman, or docker.
# On Windows, auto with a Podman CLI that has no machine continues inside the
# WSL distro local-llm. This value is not read by the containers.
CONTAINER_RUNTIME=auto

# --- host (compose bind mount) ---
# Host directory mounted read-only at /workspace/app in indexer + tools.
# Default is sample/ (the calculator fixture). app/ is the llm-client and is
# not the tree under review. Windows forms are fine when using
# scripts/deploy.py (it maps d:/svn/mon_projet -> /mnt/d/svn/mon_projet for
# WSL Podman). On native Linux the path is used as given. A missing
# directory is not created. Raw `podman compose` from WSL needs the POSIX form.
# After changing this, run: python scripts/deploy.py index
CODEBASE_PATH=./sample

# --- agent ---
AGENT_PORT=8090
AGENT_BEARER_TOKEN=changeme-generate-a-real-secret
# Long jobs (index, cmake, several clangd hops). The model stops and answers in text after this.
AGENT_TOOL_LOOP_MAX_ITERATIONS=48
# Backstop for one hop (llm, embedder, or one tool), not a target latency.
# A large checkout can spend hours in clangd, cmake, or a full-context prefill.
# Stop the question from the UI. This only kills a stuck call.
AGENT_REQUEST_TIMEOUT_SECONDS=14400
# Automatic retries (openai SDK, exponential backoff) toward llm/embedder on
# connection errors, 429 and 5xx. 0 disables.
AGENT_LLM_MAX_RETRIES=2
# Cap concurrent POST /chat (protects llm). Extra callers get 503.
AGENT_MAX_CONCURRENT=2
# Token budget before each LLM call (llama-server /tokenize, else len/4).
AGENT_CONTEXT_BUDGET_TOKENS=28544
# Characters of the repository sketch sent on architecture questions.
# The walk covers the whole checkout; this only caps what the model reads.
AGENT_REPO_MAP_CHARS=16000
# Second LLM pass that only deletes sentences contradicted by cited chunks.
AGENT_REFLECT=0
# When rules do not already choose direct vs code, one short LLM call may.
# 0 keeps every undecided question on the repository path (retrieval + tools).
AGENT_GATE_CLASSIFY=1
# In-memory multi-turn history (no disk). Expired conversations are dropped.
# A long task must still find its own history. 8 h, 24 turns.
AGENT_CONVERSATION_TTL_SECONDS=28800
AGENT_CONVERSATION_MAX_TURNS=24
# structlog minimum level (agent, indexer, trainer).
LOG_LEVEL=INFO
# Whole POST /chat from `app` / `deploy ask`. Several slow hops fit under this.
APP_REQUEST_TIMEOUT_SECONDS=172800

# --- llm ---
LLM_PORT=8080
# container = compose `llm` service. host = `evo-x5` host `llama-server`.
LLM_SERVE=container
LLM_BASE_URL=http://llm:8080
LLM_MODEL_PATH=/models/Qwen2.5-Coder-14B-Instruct-Q5_K_M.gguf
# 1 = llama-server router: pick a GGUF from the page without recreating the container.
LLM_ROUTER=1
# How many chat models may sit in memory at once. 1 avoids loading a second GGUF.
LLM_MODELS_MAX=1
# Optional LoRA adapter (empty until `python scripts/deploy.py train`):
LLM_LORA_PATH=
# Build arg (1 = GPU image, 0 = CPU-only - see .env.test).
LLM_GPU_ARG=1
# GPU layer offload. The 16g profile uses auto. 24g and 48g use 999 (every layer on the GPU).
# `python scripts/deploy.py gpu-profile 16g|24g|24g-30b|48g|48g-30b|48g-32b|evo-x5`
# writes the matching file from config/profiles/. Larger GGUF files need `fetch-extra` first.
# `evo-x5` is the GMKtec EVO-X5 Pro (Ryzen AI Max+ PRO 495). `up` serves the
# 119B on the host. The CUDA `llm` container is not started.
# Pick a NVIDIA profile from nvidia-smi memory.total, not from Task Manager (that number adds shared RAM).
# evo-x5 has no nvidia-smi. Use that name only on the EVO-X5 Pro.
LLM_NGL=auto
# Hard token window. A prompt longer than this is shortened by the agent, not a crash.
LLM_CTX_SIZE=32768
# KV cache dtype. 16g and 24g use q8_0. 48g uses f16.
# 32768 is the 14B training length. The evo-x5 profile sets 262144 (Mistral Small 4).
LLM_CACHE_TYPE_K=q8_0
LLM_CACHE_TYPE_V=q8_0
LLM_PARALLEL=1
# MiB of VRAM to leave free, and max MiB of system RAM for the KV cache.
LLM_GPU_MARGIN_MIB=2048
LLM_CACHE_RAM_MIB=4096
# Xeon: set LLM_THREADS to the physical core count (not hyper-threads) before the first up.
# llama.cpp's auto count uses every logical thread and is slower on these CPUs.
# Dual socket: LLM_THREADS=<cores on both sockets> and LLM_NUMA=distribute.
# One socket: LLM_NUMA=isolate. Empty NUMA is fine on a single socket.
LLM_THREADS=
LLM_THREADS_BATCH=
LLM_NUMA=

# --- trainer (QLoRA; profile `train` only) ---
TRAIN_BASE_MODEL=/models/hf/Qwen2.5-7B-Instruct
TRAIN_ADAPTER_OUT=/models/adapters
TRAIN_DATASET_DIR=/models/training
TRAIN_MAX_STEPS=200
TRAIN_LORA_RANK=16
TRAIN_LORA_ALPHA=32
TRAIN_MAX_SEQ_LENGTH=2048

# --- embedder ---
EMBEDDER_PORT=8081
EMBEDDER_BASE_URL=http://embedder:8081
EMBEDDER_MODEL_PATH=/models/nomic-embed-text-v1.5.Q8_0.gguf
# 16g profile: both 0 (CPU). 24g and 48g: GPU image and NGL=999.
EMBEDDER_GPU_ARG=0
EMBEDDER_NGL=0
# CPU tuning, same semantics as LLM_THREADS / LLM_NUMA (empty = auto).
EMBEDDER_THREADS=
EMBEDDER_NUMA=

# --- reranker (same llama-server image as embedder; empty URL skips the pass) ---
RERANKER_PORT=8082
RERANKER_BASE_URL=http://reranker:8082
RERANKER_MODEL_PATH=/models/bge-reranker-v2-m3-Q8_0.gguf
# 16g profile: 0 (CPU). 24g and 48g: 999.
RERANKER_NGL=0
RERANKER_THREADS=
RERANKER_NUMA=

# --- qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=code_chunks

# --- tools ---
TOOLS_PORT=8091
TOOLS_BASE_URL=http://tools:8091
# Every tools subprocess (build, test, clangd, search, git, svn).
TOOLS_BUILD_TIMEOUT_SECONDS=14400
TOOLS_CMAKE_PRESET=release
TOOLS_PROJECT_ROOT=/workspace/app
# 1 = /health is 503 when cmake/ctest/git/rg/... are missing (compose default).
TOOLS_HEALTH_STRICT=1

# --- patch (working-copy edits; not published; checkout mount is read-write) ---
PATCH_PORT=8093
PATCH_BASE_URL=http://patch:8093

# --- indexer ---
INDEXER_SOURCE_ROOT=/workspace/app

# --- mcp (Cursor / Claude Code / OpenCode; published 127.0.0.1 only) ---
MCP_PORT=8092
# http = Streamable HTTP on /mcp (default compose). stdio = `compose run --rm -T mcp`.
MCP_TRANSPORT=http
# mcp -> agent /chat. Same budget as APP_REQUEST_TIMEOUT_SECONDS.
MCP_REQUEST_TIMEOUT_SECONDS=172800
# Same URL `app` uses. Override only if agent is reached under another name.
AGENT_BASE_URL=http://agent:8090
