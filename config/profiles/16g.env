# 16 Go (RTX 4080). The 14B Q5 stays on the GPU. Embedder and reranker stay on CPU.
# Safe on every machine that already runs this stack.
LLM_MODEL_PATH=/models/Qwen2.5-Coder-14B-Instruct-Q5_K_M.gguf
LLM_CTX_SIZE=32768
LLM_NGL=auto
LLM_CACHE_TYPE_K=q8_0
LLM_CACHE_TYPE_V=q8_0
LLM_GPU_MARGIN_MIB=2048
LLM_CACHE_RAM_MIB=4096
EMBEDDER_GPU_ARG=0
EMBEDDER_NGL=0
RERANKER_NGL=0
