# Case: stronger model on 24 Go dedicated (Quadro RTX 6000, memory.total ~24576 MiB).
# Compare answers with the 24g profile (same card, 14B Q5). Weights are ~20.2 GiB.
# q8_0 KV at 32768 is about 1.5 GiB. Margin is 512 so the file can sit on the card.
# If llm never becomes healthy, this case does not fit: switch back to 24g.
# Qwen3-Coder tool calls need one manual check after the first load.
LLM_MODEL_PATH=/models/Qwen3-Coder-30B-A3B-Instruct-Q5_K_M.gguf
LLM_CTX_SIZE=32768
LLM_NGL=999
LLM_CACHE_TYPE_K=q8_0
LLM_CACHE_TYPE_V=q8_0
LLM_GPU_MARGIN_MIB=512
LLM_CACHE_RAM_MIB=4096
EMBEDDER_GPU_ARG=1
EMBEDDER_NGL=999
RERANKER_NGL=999
LLM_SERVE=container
LLM_BASE_URL=http://llm:8080
