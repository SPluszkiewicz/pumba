# 48 Go dedicated (RTX 6000 Ada). nvidia-smi memory.total is about 46068 MiB with ECC on, or 49152 without.
# f16 KV fits next to the 14B Q5. A larger GGUF is a later choice, after this profile is up.
LLM_MODEL_PATH=/models/Qwen2.5-Coder-14B-Instruct-Q5_K_M.gguf
LLM_CTX_SIZE=32768
LLM_NGL=999
LLM_CACHE_TYPE_K=f16
LLM_CACHE_TYPE_V=f16
LLM_GPU_MARGIN_MIB=2048
LLM_CACHE_RAM_MIB=4096
EMBEDDER_GPU_ARG=1
EMBEDDER_NGL=999
RERANKER_NGL=999
