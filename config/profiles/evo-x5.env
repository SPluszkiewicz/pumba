# GMKtec EVO-X5 Pro. Ryzen AI Max+ PRO 495, Radeon 8065S, 192 Go unifiés.
# Le 119B ne passe pas par l'image CUDA : llama-server tourne sur l'hôte.
# python scripts/host/evo_x5_serve.py
# Ne pas démarrer le service compose `llm` (il prendrait le port 8080 sans ce GPU).
LLM_SERVE=host
LLM_MODEL_PATH=/models/UD-Q5_K_M/Mistral-Small-4-119B-2603-UD-Q5_K_M-00001-of-00003.gguf
LLM_CTX_SIZE=32768
LLM_NGL=999
LLM_CACHE_TYPE_K=q8_0
LLM_CACHE_TYPE_V=q8_0
LLM_THREADS=16
LLM_THREADS_BATCH=16
LLM_PARALLEL=1
LLM_GPU_ARG=0
EMBEDDER_GPU_ARG=0
EMBEDDER_NGL=0
RERANKER_NGL=0
LLM_GPU_MARGIN_MIB=16384
LLM_CACHE_RAM_MIB=16384
