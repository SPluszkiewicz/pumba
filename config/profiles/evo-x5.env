# GMKtec EVO-X5 Pro. Ryzen AI Max+ PRO 495, Radeon 8065S, 192 Go unified.
# Chat runs on the Radeon through host llama-server (Vulkan). The CUDA image does not see this GPU.
# Embedder and reranker stay on the CPU. They share the chat model's memory bus, and the
# 55 TOPS NPU does not run these GGUF files. Leave that NPU free for a gate.
# POST /review calls the chat model. It does not load a second one.
LLM_SERVE=host
# The agent container calls the host process. The page stays on 127.0.0.1:8090.
LLM_BASE_URL=http://host.containers.internal:8080
LLM_MODEL_PATH=/models/UD-Q5_K_M/Mistral-Small-4-119B-2603-UD-Q5_K_M-00001-of-00003.gguf
# Mistral Small 4 is trained at 256 * 1024. The 14B profiles stay at 32768.
LLM_CTX_SIZE=262144
# The agent compresses at this budget, then keeps 3200 (template) and 1024 (reply).
AGENT_CONTEXT_BUDGET_TOKENS=262144
LLM_NGL=999
LLM_CACHE_TYPE_K=q8_0
LLM_CACHE_TYPE_V=q8_0
LLM_THREADS=16
LLM_THREADS_BATCH=16
LLM_PARALLEL=1
LLM_GPU_ARG=0
# CPU. Do not point these at the GPU or the NPU.
EMBEDDER_GPU_ARG=0
EMBEDDER_NGL=0
RERANKER_NGL=0
LLM_GPU_MARGIN_MIB=16384
LLM_CACHE_RAM_MIB=16384
# QLoRA base. Same model as the GGUF above. ~242 GiB under models/hf/.
TRAIN_BASE_MODEL=/models/hf/Mistral-Small-4-119B-2603
