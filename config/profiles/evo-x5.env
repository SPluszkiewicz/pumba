# GMKtec EVO-X5 Pro. Ryzen AI Max+ PRO 495, Radeon 8065S, 192 Go unifiés.
# Le 119B ne passe pas par l'image CUDA. `python scripts/deploy.py up` lance llama-server.
LLM_SERVE=host
# The agent container calls the host process. The page stays on 127.0.0.1:8090.
LLM_BASE_URL=http://host.containers.internal:8080
LLM_MODEL_PATH=/models/UD-Q5_K_M/Mistral-Small-4-119B-2603-UD-Q5_K_M-00001-of-00003.gguf
# Mistral Small 4 is trained at 256 * 1024. The 14B profiles stay at 32768.
LLM_CTX_SIZE=262144
# The agent compresses at this budget, then keeps 3200 (template) and 1024 (reply).
AGENT_CONTEXT_BUDGET_TOKENS=262144
LLM_NGL=999
LLM_CACHE_TYPE_K=q8_0
LLM_CACHE_TYPE_V=q8_0
LLM_THREADS=16
LLM_THREADS_BATCH=16
LLM_PARALLEL=1
LLM_GPU_ARG=0
EMBEDDER_GPU_ARG=0
EMBEDDER_NGL=0
RERANKER_NGL=0
LLM_GPU_MARGIN_MIB=16384
LLM_CACHE_RAM_MIB=16384
