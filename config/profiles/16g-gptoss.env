# Case: another chat model on the 16 Go card (RTX 4080), to compare with `16g`.
# gpt-oss-20b MXFP4, ~11.3 GiB, native tool calls (Harmony format in llama.cpp).
# Same settings as 16g: embedder and reranker stay on CPU, q8_0 KV at 32768.
# One tool-call request is needed after the first load: the chat template is not the Qwen2.5 one.
# If llm never becomes healthy, go back to 16g.
LLM_MODEL_PATH=/models/gpt-oss-20b-MXFP4.gguf
LLM_CTX_SIZE=32768
LLM_NGL=auto
LLM_CACHE_TYPE_K=q8_0
LLM_CACHE_TYPE_V=q8_0
LLM_GPU_MARGIN_MIB=2048
LLM_CACHE_RAM_MIB=4096
EMBEDDER_GPU_ARG=0
EMBEDDER_NGL=0
RERANKER_NGL=0
LLM_SERVE=container
LLM_BASE_URL=http://llm:8080
