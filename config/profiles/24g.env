# 24 Go dedicated (Quadro RTX 6000). nvidia-smi memory.total is about 24576 MiB.
# Task Manager "56 Go" is often 24 Go on the card plus shared system RAM. Do not use that shared RAM:
# it is the Xeon, and it is the slow path. q8_0 KV leaves room for the embedder and the reranker.
LLM_MODEL_PATH=/models/Qwen2.5-Coder-14B-Instruct-Q5_K_M.gguf
LLM_CTX_SIZE=32768
LLM_NGL=999
LLM_CACHE_TYPE_K=q8_0
LLM_CACHE_TYPE_V=q8_0
LLM_GPU_MARGIN_MIB=2048
LLM_CACHE_RAM_MIB=4096
EMBEDDER_GPU_ARG=1
EMBEDDER_NGL=999
RERANKER_NGL=999
