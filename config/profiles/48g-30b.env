# Case: stronger MoE on 48 Go (RTX 6000 Ada). Q8 weights are ~30.3 GiB, f16 KV fits beside them.
# Compare with 48g (same card, 14B) and with 24g-30b (same family, Q5).
# Qwen3-Coder tool calls need one manual check after the first load.
LLM_MODEL_PATH=/models/Qwen3-Coder-30B-A3B-Instruct-Q8_0.gguf
LLM_CTX_SIZE=32768
LLM_NGL=999
LLM_CACHE_TYPE_K=f16
LLM_CACHE_TYPE_V=f16
LLM_GPU_MARGIN_MIB=2048
LLM_CACHE_RAM_MIB=4096
EMBEDDER_GPU_ARG=1
EMBEDDER_NGL=999
RERANKER_NGL=999
