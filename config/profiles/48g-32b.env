# Case: denser coder, same Qwen2.5 family as the 14B, on 48 Go. Q5 weights are ~21.7 GiB.
# f16 KV for 32B at 32768 is about 9 GiB, so this stays on a 48 Go card and does not fit 24 Go.
# Compare with 48g (14B) and with 48g-30b (MoE, fewer active parameters).
LLM_MODEL_PATH=/models/Qwen2.5-Coder-32B-Instruct-Q5_K_M.gguf
LLM_CTX_SIZE=32768
LLM_NGL=999
LLM_CACHE_TYPE_K=f16
LLM_CACHE_TYPE_V=f16
LLM_GPU_MARGIN_MIB=2048
LLM_CACHE_RAM_MIB=4096
EMBEDDER_GPU_ARG=1
EMBEDDER_NGL=999
RERANKER_NGL=999
LLM_SERVE=container
LLM_BASE_URL=http://llm:8080
