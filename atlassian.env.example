# Jira and Confluence Server/Data Center. Not Atlassian Cloud.
# Copy to atlassian.env (already done if that file exists) and fill the four
# values. Token: avatar → Profile → Personal Access Tokens.
# Do not commit atlassian.env.

JIRA_URL=
JIRA_PERSONAL_TOKEN=

CONFLUENCE_URL=
CONFLUENCE_PERSONAL_TOKEN=

# Live API, read-only. Tickets are not indexed.
READ_ONLY_MODE=true
ENABLED_TOOLS=jira_search,jira_get_issue,confluence_search,confluence_get_page

# An enterprise CA already in the OS trust store stays verified.
# A self-signed certificate the OS does not trust: set both to false.
JIRA_SSL_VERIFY=true
CONFLUENCE_SSL_VERIFY=true
