# Env file for the CI/smoke-test workflow (see docs/guides/testing.md).
# A full, standalone copy of .env.example (not a partial override) because
# `--env-file` replaces rather than merges on some compose implementations -
# keep every value in sync with .env.example except the ones commented below.
#
# Usage:
#   podman compose --env-file .env.test --profile test build llm embedder
#   podman compose --env-file .env.test up -d qdrant llm embedder tools agent
#   podman compose --env-file .env.test --profile test run --rm smoke-test

# --- agent ---
AGENT_PORT=8090
# Fixed, non-secret token: fine for an ephemeral, network-isolated CI stack -
# never reuse this value outside the test profile.
AGENT_BEARER_TOKEN=ci-smoke-test-token
AGENT_TOOL_LOOP_MAX_ITERATIONS=4
AGENT_LOOP_NUDGES=3
AGENT_LOOP_MALFORMED_LIMIT=3
AGENT_LOOP_REPEAT_LIMIT=3
# Short on purpose: the smoke profile uses the 0.5B model and app/, not a large tree.
AGENT_REQUEST_TIMEOUT_SECONDS=120
AGENT_LLM_MAX_RETRIES=2
# The 0.5B stand-in mislabels repository questions as "direct" and skips
# retrieval. Rules still catch arithmetic and greetings; everything else
# stays on the code path.
AGENT_GATE_CLASSIFY=0

# --- llm ---
LLM_PORT=8080
LLM_BASE_URL=http://llm:8080
# Swapped to the tiny CI model - see CONTRACTS.md ("Models" table).
LLM_MODEL_PATH=/models/Qwen2.5-0.5B-Instruct-Q4_K_M.gguf
# Forces containers/llm/Containerfile's CPU-only build path - no GPU needed
# (or available) in most CI runners.
LLM_GPU_ARG=0

# --- embedder ---
EMBEDDER_PORT=8081
EMBEDDER_BASE_URL=http://embedder:8081
# NOT swapped - see CONTRACTS.md: changing this would change the embedding
# dimension and break the 768-dim Qdrant collection assumption.
EMBEDDER_MODEL_PATH=/models/nomic-embed-text-v1.5.Q8_0.gguf
EMBEDDER_GPU_ARG=0

# Empty: the smoke stack does not start `reranker` and does not download its GGUF.
RERANKER_BASE_URL=

# --- qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=code_chunks

# --- host (compose bind mount) ---
CODEBASE_PATH=./app

# --- tools ---
TOOLS_PORT=8091
TOOLS_BASE_URL=http://tools:8091
# Short on purpose for the smoke profile, and shorter than
# AGENT_REQUEST_TIMEOUT_SECONDS above. A cmake budget longer than the
# agent's HTTP timeout makes the agent abandon the call while the build
# is still running, so /chat never answers inside the smoke client's wait.
# Production default is 14400.
TOOLS_BUILD_TIMEOUT_SECONDS=60
TOOLS_CMAKE_PRESET=release
TOOLS_PROJECT_ROOT=/workspace/app

# --- indexer ---
INDEXER_SOURCE_ROOT=/workspace/app

# --- mcp / patch (smoke-test probes them on the internal networks) ---
MCP_PORT=8092
MCP_TRANSPORT=http
# Short on purpose for the smoke profile. Production default is 172800.
MCP_REQUEST_TIMEOUT_SECONDS=600
AGENT_BASE_URL=http://agent:8090
